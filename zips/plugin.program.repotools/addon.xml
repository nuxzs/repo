<?xml version="1.0" encoding="UTF-8"?>
<addon
    id="plugin.program.repotools"
    name="[COLOR mediumpurple]CorpTeam Repo[/COLOR] [COLOR white]Tools[/COLOR]"
    version="1.0.0"
    provider-name="[COLOR mediumpurple]CorpTeam[/COLOR]">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Search and browse Kodi repositories</summary>

        <description lang="en_GB">Repo Tools lets you browse installed repositories, search add-ons, check repository health, inspect metadata, and view video add-ons before installing them.</description>

        <disclaimer lang="en_GB">This add-on only reads repository metadata already available from installed repositories. It does not host or provide media content.</disclaimer>

        <platform>all</platform>
        <language>en</language>
        <license>MIT</license>

        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>

</addon>
