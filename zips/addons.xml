<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
  <!-- REPO -->
<addon id="repository.KodiToolsPro" name="[COLOR mediumpurple]KodiTools[/COLOR] [COLOR white]Pro[/COLOR]" version="1.6" provider-name="[COLOR mediumpurple]CorpTeam[/COLOR]">
    <extension point="xbmc.addon.repository" name="KodiToolsPro repository">
	    <dir>
            <info compressed="false">https://raw.githubusercontent.com/nuxzs/repo/main/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/nuxzs/repo/main/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/nuxzs/repo/main/zips</datadir>
        </dir>
		<dir>
            <info compressed="false">https://raw.githubusercontent.com/peno64/repository.peno64/master/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/peno64/repository.peno64/master/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/peno64/repository.peno64/master/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>KodiToolsPro repository</summary>
        <description>
[B][COLOR mediumpurple]KodiTools[/COLOR][/B] brings together useful Kodi tools,
repository utilities, IPTV helpers, maintenance scripts,
and Repo Tools in one clean and easy-to-use repository experience.
        </description>
        <disclaimer></disclaimer>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
  <!-- REPOTOOLS -->
<addon
    id="plugin.program.repotools"
    name="[B][COLOR mediumpurple]CorpTeam Repo[/COLOR] [COLOR white]Tools[/COLOR][/B]"
    version="1.0.0"
    provider-name="[COLOR mediumpurple]CorpTeam[/COLOR]">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Search and browse Kodi repositories</summary>

        <description lang="en_GB">Repo Tools lets you browse installed repositories, search add-ons, check repository health, inspect metadata, and view video add-ons before installing them.</description>

        <disclaimer lang="en_GB">This add-on only reads repository metadata already available from installed repositories. It does not host or provide media content.</disclaimer>

        <platform>all</platform>
        <language>en</language>
        <license>MIT</license>

        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>

</addon>

</addons>
